# --- Arka Outbound Agent — environment ---
# Copy to `.env.local` and fill in.

# Run mode. In "production" NO fabricated data is ever used: if a company,
# decision-maker, or verified email can't be obtained, the campaign is BLOCKED.
# In "demo" the pipeline may fall back to clearly-labelled mock data.
APP_MODE=demo

# --- Persistence (REQUIRED — the app has no in-memory fallback) ---
# From your Supabase project settings. The service-role key is server-only.
# Apply supabase/migrations/0001_init.sql first (supabase db push or SQL editor).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (research, personalization, drafting) ---
ANTHROPIC_API_KEY=
# Base/fallback model. Cost tiering below routes each stage to a cheaper model:
CLAUDE_MODEL=claude-opus-4-8
# Cheap tier — research structuring + personalization (mechanical work).
CLAUDE_MODEL_FAST=claude-haiku-4-5
# Writer tier — the email copy + web-search research (quality-critical).
CLAUDE_MODEL_WRITER=claude-sonnet-5

# --- Apollo.io (companies + decision-makers + verified emails) ---
APOLLO_API_KEY=

# Trust score (0-100) an outreach campaign must reach before it can be approved.
TRUST_THRESHOLD=70

# Let the research agent gather live facts via Claude's web_search tool.
# Grounded research raises the "researchGrounding" trust component to 100.
ENABLE_WEB_SEARCH=false

# DEMO ONLY: make the mock decision-maker present a "verified" email so you can
# see the full happy path offline. Ignored in production. Without it, mock leads
# correctly BLOCK on "no verified email".
DEMO_FORCE_VERIFIED=false

# --- Email sending — apply migrations 0002..0005 first ---
# Provider order: Resend → SMTP → simulated (nothing delivered).

# EASIEST: Resend (https://resend.com) — API key only, no SMTP setup.
# Verify your sending domain there, then paste the key:
RESEND_API_KEY=

# Alternative: any SMTP server (Gmail app password, Mailgun, SES, …)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Default sender (the app asks for/remembers a From address per user too).
FROM_EMAIL=
FROM_NAME=

# Force simulation even with a provider configured (safe testing).
SIMULATE_SEND=false

# Signs the login session cookie (defaults to the Supabase key if unset).
SESSION_SECRET=
